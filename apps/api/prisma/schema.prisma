datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Gender {
  MALE
  FEMALE
}

model Governorate {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  name String @unique @map("name")

  cities City[]

  @@index([name], name: "idx_governorate_name")
  @@map("governorate")
}

model City {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  name          String @map("name")
  governorateId String @map("governorate_id")

  governorate Governorate @relation(fields: [governorateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  areas       Area[]

  @@unique([governorateId, name], name: "uq_city_governorate_name")
  @@index([name], name: "idx_city_name")
  @@index([governorateId], name: "idx_city_governorate_id")
  @@map("city")
}

model Area {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  name   String @map("name")
  cityId String @map("city_id")

  city City @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([cityId, name], name: "uq_area_city_name")
  @@index([name], name: "idx_area_name")
  @@index([cityId], name: "idx_area_city_id")
  @@map("area")
}

model University {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  name String @unique @map("name")

  students StudentProfile[]

  @@index([name], name: "idx_university_name")
  @@map("university")
}

enum UserRole {
  STUDENT
  OWNER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  email           String?   @unique @map("email")
  phone           String    @unique @map("phone")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  gender          Gender    @map("gender")
  role            UserRole  @map("role")
  isActive        Boolean   @default(true) @map("is_active")
  isBlocked       Boolean   @default(false) @map("is_blocked")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")

  studentProfile               StudentProfile?
  ownerProfile                 OwnerProfile?
  verificationRequests         VerificationRequest[] @relation("UserVerificationRequests")
  reviewedVerificationRequests VerificationRequest[] @relation("ReviewedVerificationRequests")

  @@index([email], name: "idx_user_email")
  @@index([phone], name: "idx_user_phone")
  @@map("user")
}

model StudentProfile {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  userId       String  @unique @map("user_id")
  universityId String  @map("university_id")
  faculty      String? @map("faculty")
  academicYear String? @map("academic_year")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  university University @relation(fields: [universityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([universityId], name: "idx_student_profile_university_id")
  @@map("student_profile")
}

model OwnerProfile {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  userId     String  @unique @map("user_id")
  nationalId String? @unique @map("national_id")
  occupation String? @map("occupation")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([nationalId], name: "idx_owner_profile_national_id")
  @@map("owner_profile")
}

model VerificationRequest {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  userId       String             @map("user_id")
  status       VerificationStatus @default(PENDING) @map("status")
  submittedAt  DateTime           @default(now()) @map("submitted_at")
  reviewedAt   DateTime?          @map("reviewed_at")
  reviewNotes  String?            @map("review_notes")
  reviewedById String?            @map("reviewed_by_id")

  user       User  @relation("UserVerificationRequests", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewedBy User? @relation("ReviewedVerificationRequests", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId], name: "idx_verification_request_user_id")
  @@map("verification_request")
}

// Note: Partial Unique Indexes for Soft Delete (where deletedAt is null)
// will be created manually in SQL migrations later because Prisma 
// currently does not support them natively in schema.prisma.
