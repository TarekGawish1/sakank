datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Gender {
  MALE
  FEMALE
}

model Governorate {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  name String @unique @map("name")

  cities     City[]
  properties Property[]

  @@index([name], name: "idx_governorate_name")
  @@map("governorate")
}

model City {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  name          String @map("name")
  governorateId String @map("governorate_id")

  governorate Governorate @relation(fields: [governorateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  areas       Area[]
  properties  Property[]

  @@unique([governorateId, name], name: "uq_city_governorate_name")
  @@index([name], name: "idx_city_name")
  @@index([governorateId], name: "idx_city_governorate_id")
  @@map("city")
}

model Area {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  name   String @map("name")
  cityId String @map("city_id")

  city       City       @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  properties Property[]

  @@unique([cityId, name], name: "uq_area_city_name")
  @@index([name], name: "idx_area_name")
  @@index([cityId], name: "idx_area_city_id")
  @@map("area")
}

model University {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  name String @unique @map("name")

  students StudentProfile[]

  @@index([name], name: "idx_university_name")
  @@map("university")
}

enum UserRole {
  STUDENT
  OWNER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  email           String?   @unique @map("email")
  phone           String    @unique @map("phone")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  gender          Gender    @map("gender")
  role            UserRole  @map("role")
  isActive        Boolean   @default(true) @map("is_active")
  isBlocked       Boolean   @default(false) @map("is_blocked")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")

  studentProfile               StudentProfile?
  ownerProfile                 OwnerProfile?
  verificationRequests         VerificationRequest[] @relation("UserVerificationRequests")
  reviewedVerificationRequests VerificationRequest[] @relation("ReviewedVerificationRequests")

  @@index([email], name: "idx_user_email")
  @@index([phone], name: "idx_user_phone")
  @@map("user")
}

model StudentProfile {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  userId       String  @unique @map("user_id")
  universityId String  @map("university_id")
  faculty      String? @map("faculty")
  academicYear String? @map("academic_year")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  university University @relation(fields: [universityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  favorites    Favorite[]
  stayRequests StayRequest[]

  @@index([universityId], name: "idx_student_profile_university_id")
  @@map("student_profile")
}

model OwnerProfile {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  userId     String  @unique @map("user_id")
  nationalId String? @unique @map("national_id")
  occupation String? @map("occupation")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  properties Property[]

  @@index([nationalId], name: "idx_owner_profile_national_id")
  @@map("owner_profile")
}

model VerificationRequest {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  userId       String             @map("user_id")
  status       VerificationStatus @default(PENDING) @map("status")
  submittedAt  DateTime           @default(now()) @map("submitted_at")
  reviewedAt   DateTime?          @map("reviewed_at")
  reviewNotes  String?            @map("review_notes")
  reviewedById String?            @map("reviewed_by_id")

  user       User  @relation("UserVerificationRequests", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewedBy User? @relation("ReviewedVerificationRequests", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId], name: "idx_verification_request_user_id")
  @@map("verification_request")
}

// Note: Partial Unique Indexes for Soft Delete (where deletedAt is null)
// will be created manually in SQL migrations later because Prisma 
// currently does not support them natively in schema.prisma.

enum PropertyType {
  APARTMENT_BUILDING
  VILLA
  HOUSE
  DORMITORY
  COMPOUND
}

model Property {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  ownerProfileId String       @map("owner_profile_id")
  governorateId  String       @map("governorate_id")
  cityId         String       @map("city_id")
  areaId         String       @map("area_id")
  title          String       @map("title")
  description    String       @map("description")
  address        String       @map("address")
  latitude       Decimal      @map("latitude") @db.Decimal
  longitude      Decimal      @map("longitude") @db.Decimal
  propertyType   PropertyType @map("property_type")

  ownerProfile OwnerProfile @relation(fields: [ownerProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  governorate  Governorate  @relation(fields: [governorateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  city         City         @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  area         Area         @relation(fields: [areaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  images PropertyImage[]
  units  Unit[]

  @@index([ownerProfileId], name: "idx_property_owner_profile_id")
  @@index([governorateId], name: "idx_property_governorate_id")
  @@index([cityId], name: "idx_property_city_id")
  @@index([areaId], name: "idx_property_area_id")
  @@index([propertyType], name: "idx_property_type")
  @@map("property")
}

model PropertyImage {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  propertyId   String  @map("property_id")
  url          String  @map("url")
  displayOrder Int     @map("display_order")
  isPrimary    Boolean @default(false) @map("is_primary")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([propertyId], name: "idx_property_image_property_id")
  @@index([displayOrder], name: "idx_property_image_display_order")
  @@map("property_image")
}

enum UnitType {
  APARTMENT
  ROOM
  BED
  STUDIO
}

enum GenderRestriction {
  MALE
  FEMALE
  MIXED
}

enum AvailabilityStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  UNAVAILABLE
}

model Unit {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  propertyId         String             @map("property_id")
  unitNumber         String             @map("unit_number")
  title              String             @map("title")
  description        String             @map("description")
  monthlyRent        Decimal            @map("monthly_rent") @db.Decimal
  securityDeposit    Decimal            @map("security_deposit") @db.Decimal
  capacity           Int                @map("capacity")
  availableBeds      Int                @map("available_beds")
  availableFrom      DateTime           @map("available_from")
  unitType           UnitType           @map("unit_type")
  genderRestriction  GenderRestriction  @map("gender_restriction")
  availabilityStatus AvailabilityStatus @map("availability_status")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  images   UnitImage[]
  listings Listing[]

  @@unique([propertyId, unitNumber], name: "uq_unit_property_id_unit_number")
  @@index([propertyId], name: "idx_unit_property_id")
  @@index([unitType], name: "idx_unit_unit_type")
  @@index([availabilityStatus], name: "idx_unit_availability_status")
  @@index([genderRestriction], name: "idx_unit_gender_restriction")
  @@index([monthlyRent], name: "idx_unit_monthly_rent")
  @@index([availableFrom], name: "idx_unit_available_from")
  @@map("unit")
}

model UnitImage {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  unitId       String  @map("unit_id")
  url          String  @map("url")
  displayOrder Int     @map("display_order")
  isPrimary    Boolean @default(false) @map("is_primary")

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([unitId], name: "idx_unit_image_unit_id")
  @@index([displayOrder], name: "idx_unit_image_display_order")
  @@map("unit_image")
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  RENTED
  ARCHIVED
}

enum StayRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

model Listing {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  unitId        String        @map("unit_id")
  status        ListingStatus @default(DRAFT) @map("status")
  publishedAt   DateTime?     @map("published_at")
  unpublishedAt DateTime?     @map("unpublished_at")
  expiresAt     DateTime?     @map("expires_at")
  isFeatured    Boolean       @default(false) @map("is_featured")

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  favorites    Favorite[]
  stayRequests StayRequest[]

  // Business Rule: Only one Listing should be actively PUBLISHED at a time.
  // This must be enforced in the service layer (or later with a partial unique index).
  @@index([unitId], name: "idx_listing_unit_id")
  @@index([status], name: "idx_listing_status")
  @@index([publishedAt], name: "idx_listing_published_at")
  @@map("listing")
}

model Favorite {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  studentProfileId String @map("student_profile_id")
  listingId        String @map("listing_id")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  listing        Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([studentProfileId, listingId], name: "uq_favorite_student_listing")
  @@index([studentProfileId], name: "idx_favorite_student_profile_id")
  @@index([listingId], name: "idx_favorite_listing_id")
  @@map("favorite")
}

model StayRequest {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  listingId        String            @map("listing_id")
  studentProfileId String            @map("student_profile_id")
  message          String?           @map("message")
  moveInDate       DateTime          @map("move_in_date")
  durationMonths   Int               @map("duration_months")
  status           StayRequestStatus @default(PENDING) @map("status")
  ownerResponse    String?           @map("owner_response")
  respondedAt      DateTime?         @map("responded_at")

  listing        Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([listingId], name: "idx_stay_request_listing_id")
  @@index([studentProfileId], name: "idx_stay_request_student_profile_id")
  @@index([status], name: "idx_stay_request_status")
  @@index([moveInDate], name: "idx_stay_request_move_in_date")
  @@map("stay_request")
}

enum NotificationType {
  STAY_REQUEST_RECEIVED
  STAY_REQUEST_ACCEPTED
  STAY_REQUEST_REJECTED
  STAY_REQUEST_CANCELLED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  SYSTEM
}

model Notification {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1) @map("version")

  userId      String           @map("user_id")
  type        NotificationType @map("type")
  title       String           @map("title")
  body        String           @map("body")
  isRead      Boolean          @default(false) @map("is_read")
  readAt      DateTime?        @map("read_at")
  referenceId String?          @map("reference_id")

  @@index([userId], name: "idx_notification_user_id")
  @@index([userId, isRead], name: "idx_notification_user_unread")
  @@index([createdAt], name: "idx_notification_created_at")
  @@map("notification")
}
