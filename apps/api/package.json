{
  "name": "@sakank/api",
  "version": "0.0.0",
  "packageManager": "pnpm@9.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npx tsc && npx tsc-alias",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:studio": "prisma studio",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.0.0",
    "cookie-parser": "^1.0.0",
    "cors": "^2.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.0.0",
    "express-rate-limit": "^7.0.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "uuid": "^10.0.0",
    "xss": "^1.0.15",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.0.0",
    "@types/cookie-parser": "^1.0.0",
    "@types/cors": "^2.0.0",
    "@types/express": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.0.0",
    "pino-pretty": "^11.0.0",
    "prisma": "^5.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=18"
  }
